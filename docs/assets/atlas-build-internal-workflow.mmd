flowchart TB
    Start["Structured delivery evidence<br/>requirements, CRs, source, specs, TDs"]
    Router["ibm-i-workflow-orchestrator<br/>Routing / Plan / Execute"]

    subgraph Analysis["Intake and analysis"]
        RN["Requirement Normalizer"]
        PA["Program Analyzer"]
        IA["Impact Analyzer"]
    end

    subgraph Specs["Specification layer"]
        FS["Functional Spec"]
        TD["Technical Design"]
        PS["Program Spec"]
        FileSpec["File Spec<br/>Markdown + JSON"]
        SR["Spec Reviewer"]
    end

    subgraph ProgramChain["Program Chain"]
        CodeGen["Code Generator<br/>RPGLE / CLLE"]
        Precheck["Compile Precheck"]
        CodeReview["Code Reviewer"]
        UT["UT Plan Generator"]
        Scaffold["Test Scaffold<br/>SQL / CL"]
    end

    subgraph FileChain["File Chain"]
        DDSGen["DDS Generator<br/>PF / LF / PRTF / DSPF"]
        DDSReview["DDS Reviewer"]
    end

    Manifest["Build evidence package<br/>task.md manifest, generated artifacts, reviews, tests"]

    Start --> Router
    Router --> RN
    Router --> PA
    PA --> IA
    RN --> FS
    IA --> PS
    FS --> TD
    TD --> PS
    TD --> FileSpec
    PS --> SR
    FileSpec --> SR
    PS --> CodeGen --> Precheck --> CodeReview --> Manifest
    PS --> UT --> Scaffold --> Manifest
    FileSpec --> DDSGen --> DDSReview --> Manifest
    Router --> Manifest

