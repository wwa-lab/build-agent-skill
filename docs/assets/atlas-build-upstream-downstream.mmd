        Design["Functional Spec and Technical Design"]
    end

    subgraph M4["M4 Build Tool"]
        Task["Approved task.md plan"]
        Specs["Program Specs and File Specs"]
        Build["RPGLE / CLLE and DDS artifacts"]
        Gates["Spec, compile, code, and DDS review gates"]
        Tests["UT Plan and SQL/CL test scaffold"]
    end

    subgraph M5["M5 Testing / Validation"]
        Package["Build evidence package"]
        Execute["Run tests on target IBM i environment"]
        Feedback["Defects, questions, and change feedback"]
    end

    Req --> Task
    Evidence --> Task
    Design --> Task
    Task --> Specs --> Build --> Gates --> Package
    Specs --> Tests --> Package
    Package --> Execute --> Feedback
    Feedback --> Task

